{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": null,

  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": null,
  "devCommand": null,

  "static": {
    "dotFiles": "ignore"
  },

  "headers": [
    {
      "source": "/(.*)\\.(css|js|json)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|svg|webp|ico|woff2|woff|ttf|eot)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],

  "redirects": [
    { "source": "/home",      "destination": "/index.html",  "statusCode": 301 },
    { "source": "/search",    "destination": "/index.html",  "statusCode": 301 },
    { "source": "/a-z|/az",   "destination": "/az-list.html","statusCode": 301 },
    { "source": "/fav|/favs", "destination": "/favorites.html", "statusCode": 301 },
    { "source": "/medicine|/med", "destination": "/index.html", "statusCode": 301 }
  ],

  "rewrites": [
    { "source": "/((?!assets|\\.vercel).*)", "destination": "/$1" }
  ],

  "notFound": {
    "path": "/404.html",
    "statusCode": 404
  },

  "functions": {}
}
